# Browser-safe values only. Contact CTAs are omitted until an inbox exists.
VITE_SITE_ORIGIN=http://127.0.0.1:5173
VITE_CONTACT_EMAIL=

# Vite exposes every VITE_* value to the browser: never put secrets here.
# A deployable build must set SITE_ORIGIN and VITE_SITE_ORIGIN to the same
# controlled HTTPS origin in the build environment.

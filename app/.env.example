# Browser-safe values only. Copy this file to app/.env.local for manual local
# setup, or let scripts/bootstrap-local.sh generate that ignored file from the
# running Supabase stack.
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=replace-with-the-local-publishable-or-anon-key
VITE_SITE_ORIGIN=http://127.0.0.1:5173
# Optional: leave empty until a project-controlled inbox exists. Contact CTAs
# are omitted when unset.
VITE_CONTACT_EMAIL=
# Optional and local-only: reveal the seed account helper in the UI while the
# app runs in Vite development mode against a loopback Supabase URL. Deployable
# builds reject this opt-in and strip the helper.
VITE_LOCAL_TEST_IDENTITIES=

# Do not put database passwords, Supabase secret/service-role keys, JWT secrets,
# or provider credentials in app/.env*. Vite exposes every VITE_* value to the
# browser. Server-only Edge Function configuration belongs in
# supabase/functions/.env locally or in Supabase hosted secrets.

# A deployable build must set SITE_ORIGIN and VITE_SITE_ORIGIN to the same
# controlled HTTPS origin in the build environment. Use
# scripts/build-frontend.sh; it refuses guessed, reserved, local, and
# parallax.org canonical domains.

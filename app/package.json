{
  "name": "parallax",
  "private": true,
  "version": "0.0.0",
  "description": "An open-source Peerlab project for making disagreement inspectable.",
  "license": "Apache-2.0",
  "author": "Peerlab",
  "homepage": "https://github.com/Swarek/parallax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swarek/parallax.git"
  },
  "bugs": {
    "url": "https://github.com/Swarek/parallax/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender && npm run gen:seo && npm run check:seo",
    "prerender": "tsx scripts/prerender.ts",
    "gen:seo": "node scripts/gen-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b",
    "check:fixtures": "node scripts/check-fixtures.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}

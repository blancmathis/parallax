# Browser-safe public Supabase config.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-cloud-anon-key

# Production origin for canonical / OG / hreflang + sitemap. Set BOTH on the host
# to the SAME value: VITE_SITE_ORIGIN (client build) and SITE_ORIGIN (the Node
# prerender + sitemap). Defaults to https://parallax.org when unset.
VITE_SITE_ORIGIN=https://parallax.org
SITE_ORIGIN=https://parallax.org

# Supabase Edge Function runtime.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-or-cloud-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# AI provider defaults. Mock is the default for local checks and Browser QA.
AI_PROVIDER=mock
AI_LIVE_ENABLED=false
AI_SOFT_BUDGET_USD=1
AI_HARD_BUDGET_USD=5
AI_LIVE_TEST_MAX_CALLS=1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=z-ai/glm-4.7-flash
OPENROUTER_MANUAL_QUALITY_MODEL=moonshotai/kimi-k2.5
OPENROUTER_API_KEY=replace-with-openrouter-key

# Optional Cloudflare Pages production values should mirror the public Vite
# variables above. Do not add service-role or OpenRouter secrets to Cloudflare
# frontend variables.

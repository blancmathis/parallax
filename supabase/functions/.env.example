# Local Edge Function configuration only. Copy to supabase/functions/.env only
# when overriding the built-in localhost defaults. This file must never contain
# a Supabase secret/service-role key, database password, JWT secret, or provider
# credential.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY into local and hosted Edge runtimes. Do not duplicate
# those values here. For a hosted environment, set CORS_ALLOWED_ORIGINS as a
# Supabase secret to canonical HTTPS frontend origins, without credentials,
# paths, queries, fragments, empty entries, or a trailing comma. Any invalid
# entry makes the Edge CORS configuration fail closed.
